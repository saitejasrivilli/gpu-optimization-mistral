# System Architecture Dashboard Environment Configuration

# Flask settings
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Server settings
PORT=5000
HOST=0.0.0.0

# Optional: GCP settings (if integrating with real services)
GOOGLE_CLOUD_PROJECT=ml-pipeline-sa
GOOGLE_APPLICATION_CREDENTIALS=/path/to/sa-key.json

# Optional: Database settings
DATABASE_URL=sqlite:///dashboard.db

# Optional: Logging
LOG_LEVEL=INFO
